APP_NAME="Newsportal CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn

# ─── CMS Settings ──────────────────────────────────────────────
CMS_NAME="Newsportal CMS"
FORCE_HTTPS=false

# ─── Database ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newsportal_cms
DB_USERNAME=root
DB_PASSWORD=

# Read replica (same as write for local dev)
DB_READ_HOST=127.0.0.1

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─── Session & Security ────────────────────────────────────────
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
SESSION_TIMEOUT=8

# ─── Mail / SMTP ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@newsportal.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Media / Storage ───────────────────────────────────────────
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_MAX_MB=10

# AWS S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Search (MeiliSearch) ──────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ─── AI Provider ───────────────────────────────────────────────
AI_PROVIDER=openai
AI_REQUIRE_HUMAN_REVIEW=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=2000

# ─── Rate Limits (requests/minute) ────────────────────────────
RL_PUBLIC_API=100
RL_SEARCH=20
RL_DASHBOARD=500
RL_MEDIA_UPLOAD=10
RL_AI=30
RL_AUTH=5

# ─── Cache TTL (seconds) ───────────────────────────────────────
CACHE_TTL_POSTS=300
CACHE_TTL_POST=3600
CACHE_TTL_CATEGORIES=3600
CACHE_TTL_SETTINGS=86400
CACHE_TTL_TOKENS=86400
CACHE_TTL_MENUS=86400
CACHE_TTL_BREAKING=60
CACHE_TTL_STATS=300

# ─── Horizon Queue ─────────────────────────────────────────────
HORIZON_PREFIX=newsportal_horizon_

# ─── Sentry Error Tracking ─────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
